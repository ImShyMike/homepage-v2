---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import PageShell from '../components/PageShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
    title?: string;
    description?: string;
    image?: ImageMetadata;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image } = Astro.props as Props;
---

<!doctype html>
<html lang="en" transition:animate="none" class="bg-ctp-crust">
    <head>
        <BaseHead title={title} description={description} image={image} />
    </head>
    <body class="text-ctp-text m-0 font-sans leading-normal">
        <PageShell>
            <slot />
        </PageShell>
    </body>
    <script is:inline data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
</html>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';
import { getColorForString } from '../utils/colors';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, date, link, repo, techStack = [], heroImage } = Astro.props as Props;
---

<Layout title={title} description={description} image={heroImage}>
    <article class="prose prose-lg max-w-none">
        <div
            class="border-ctp-surface0 flex flex-col items-center justify-center border-b px-5 pt-4"
        >
            <h1 class="mt-4 mb-2! text-3xl font-bold">{title}</h1>
            <p class="m-0! text-lg">{description}</p>
            {
                techStack.length > 0 && (
                    <div class="m-0! flex flex-1 flex-wrap items-center justify-center gap-2 pt-2 text-center">
                        {techStack.map((tech) => (
                            <span
                                class={`rounded border px-2 py-0.5 text-sm ${getColorForString(tech)}`}
                            >
                                {tech}
                            </span>
                        ))}
                    </div>
                )
            }
            {
                heroImage && (
                    <Image
                        src={heroImage}
                        format="webp"
                        alt={title}
                        widths={[150, 300, 600, heroImage.width]}
                        height={300}
                        quality="high"
                        priority
                        class="mt-4!"
                        layout="full-width"
                    />
                )
            }
        </div>
        <div class="border-ctp-surface0 flex flex-row border-b">
            {
                repo && (
                    <a
                        href={repo}
                        class="text-ctp-subtext0 border-ctp-surface0 m-0! flex flex-1 items-center justify-center gap-1 border-r p-1 text-center"
                    >
                        <Github class="h-4 w-4" /> Code
                    </a>
                )
            }
            {
                link && (
                    <a
                        href={link}
                        class="text-ctp-subtext0 border-ctp-surface0 m-0! flex flex-1 items-center justify-center gap-1 border-r p-1 text-center"
                    >
                        <ExternalLink class="h-4 w-4" /> Live
                    </a>
                )
            }
            <div class="flex flex-1 items-center justify-center text-center">
                <p class="text-ctp-subtext0 m-0! flex-1 p-1 text-center md:text-lg text-sm">
                    <FormattedDate date={date} />
                </p>
            </div>
        </div>
        <div class="px-5 pt-4 pb-2 md:px-10 lg:px-20">
            <slot />
        </div>
    </article>
</Layout>

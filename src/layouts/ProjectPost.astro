---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';

type Props = CollectionEntry<'projects'>['data'];

const {
    title,
    description,
    date,
    link,
    repo,
    techStack = [],
    tags = [],
    heroImage,
} = Astro.props as Props;
---

<Layout title={title} description={description} image={heroImage}>
    <article class="prose prose-lg max-w-none">
        <div
            class="border-ctp-surface0 flex flex-col items-center justify-center border-b px-5 pt-4 pb-5"
        >
            <h1 class="mt-4 text-3xl font-bold">{title}</h1>
            <p class="m-0! text-lg">{description}</p>
            {heroImage && <Image src={heroImage} format="webp" alt={title} class="max-w-140" />}
            <p class="text-ctp-subtext0 m-0!"><FormattedDate date={date} /></p>
            <div class="mt-2 flex gap-4">
                {
                    link && (
                        <a
                            href={link}
                            class="border-ctp-surface1 flex items-center gap-1 border px-2 text-inherit"
                        >
                            <ExternalLink class="h-4 w-4" /> Live
                        </a>
                    )
                }
                {
                    repo && (
                        <a
                            href={repo}
                            class="border-ctp-surface1 flex items-center gap-1 border px-2 text-inherit"
                        >
                            <Github class="h-4 w-4" /> Code
                        </a>
                    )
                }
            </div>
        </div>
        <div class="border-ctp-surface0 flex justify-between border-b px-5 py-1">
            {tags.length > 0 && <p class="m-0!">#{tags.join(', #')}</p>}
            {techStack.length > 0 && <p class="m-0!">{techStack.join(', ')}</p>}
        </div>
        <div class="px-20 pt-4 pb-2">
            <slot />
        </div>
    </article>
</Layout>

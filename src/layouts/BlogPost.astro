---
import "./../styles/markdown.css";
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.svelte';
import Layout from './Layout.astro';
import { getColorForString } from '../utils/colors';
import PageScroll from '../components/PageScroll.astro';

type Props = CollectionEntry<'blog'>['data'] & { wordCount: number };

const { title, description, pubDate, updatedDate, tags = [], heroImage, wordCount } = Astro.props;
const readingTime = Math.ceil(wordCount / 200);
---

<Layout title={title} description={description} image={heroImage}>
    <PageScroll />
    <article class="prose prose-lg max-w-none">
        <div
            class="border-ctp-surface0 flex flex-col items-center justify-center border-b px-5 pt-4"
        >
            <h1 class="mt-4 mb-2! text-3xl font-bold">{title}</h1>
            <p class="m-0! text-lg">{description}</p>
            {
                tags.length > 0 && (
                    <div class="m-0! flex flex-1 flex-wrap items-center justify-center gap-2 pt-2 text-center">
                        {tags.map((tag) => (
                            <span
                                class={`rounded border px-2 py-0.5 text-sm ${getColorForString(tag)}`}
                            >
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
            {
                heroImage && (
                    <Image
                        src={heroImage}
                        format="webp"
                        alt={title}
                        widths={[150, 300, 600, heroImage.width]}
                        height={300}
                        quality="high"
                        priority
                        class="mt-4!"
                        layout="full-width"
                    />
                )
            }
        </div>
        <div class="border-ctp-surface0 flex flex-row border-b">
            <div
                class="border-ctp-surface0 flex flex-1 items-center justify-center border-r text-center text-sm md:text-lg"
            >
                <p class="text-ctp-subtext0 m-0! p-1">
                    published on <FormattedDate date={pubDate} />
                </p>
            </div>
            {
                updatedDate && (
                    <div class="border-ctp-surface0 flex flex-1 items-center justify-center border-r text-center text-sm md:text-lg">
                        <p class="text-ctp-subtext0 m-0! p-1">
                            updated on <FormattedDate date={updatedDate} />
                        </p>
                    </div>
                )
            }
            <div class="flex flex-1 items-center justify-center text-center">
                <p class="text-ctp-subtext0 m-0! flex-1 p-1 text-center text-sm md:text-lg">
                    {wordCount} words ({readingTime} mins)
                </p>
            </div>
        </div>
        <div class="px-5 pt-4 pb-2 md:px-10 lg:px-20">
            <slot />
        </div>
    </article>
    <section class="mt-8 px-5 pt-4 pb-4">
        <Giscus client:only="svelte" />
    </section>
    <a
        href={`${Astro.url.pathname}/raw`}
        class="text-ctp-subtext0 mb-4 ml-6 inline-block px-1 hover:underline"
        >check out the raw text version of this post
    </a>
</Layout>

<style>
    .gsc-main {
        gap: 0px !important;
    }
</style>

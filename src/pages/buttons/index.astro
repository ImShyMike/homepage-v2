---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { Image } from 'astro:assets';

const buttons = await getCollection('buttons');
---

<Layout title={`Buttons | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
    <section class="flex flex-col items-center justify-center px-5 pt-4 pb-2">
        <h2 class="mb-4 text-2xl font-bold">88x31s</h2>
        <div class="flex flex-row flex-wrap items-center justify-center">
            {
                buttons.map((b) => {
                    const { image } = b.data;

                    return (
                        <a
                            href={b.data.link ?? b.data.rlink}
                            title={b.data.id}
                            target="_blank"
                            rel="noopener"
                            class="button-link mr-2 mb-2 inline-block transition-transform hover:scale-150"
                        >
                            {typeof image === 'string' ? (
                                <img
                                    src={image}
                                    alt={b.data.id}
                                    width={88}
                                    height={31}
                                    class="image-pixelated url-image"
                                    loading="eager"
                                />
                            ) : (
                                <Image
                                    src={image}
                                    alt={b.data.id}
                                    width={image.width}
                                    height={image.height}
                                    class="image-pixelated"
                                    loading="eager"
                                />
                            )}
                        </a>
                    );
                })
            }
        </div>
    </section>
</Layout>

<style>
    .button-link {
        background-color: transparent !important;
    }

    .image-pixelated {
        image-rendering: pixelated;
        -moz-image-rendering: crisp-edges;
        -webkit-image-rendering: crisp-edges;
        color: transparent !important;
    }

    .url-image::before {
        display: none;
        content: '';
    }

    .url-image:empty {
        content: '';
        width: 88px;
        height: 31px;
        background-image: url('/button-not-found.png');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
</style>

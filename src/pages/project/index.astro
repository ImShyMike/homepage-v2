---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title={`Projects | ${SITE_TITLE}`} description="Projects and experiments.">
    <div class="px-5 pt-4 pb-5">
        <h1 class="mb-4 text-3xl font-bold">Projects</h1>
        <p class="mb-4">The gallery of unfinished projects</p>
        <div class="flex flex-col gap-4">
            {projects.length === 0 && <p class="mb-4">No projects yet.</p>}
            {projects.map((project) => <ProjectCard project={project} />)}
        </div>
    </div>
</Layout>

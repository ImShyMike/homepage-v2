---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title={`Projects | ${SITE_TITLE}`} description="Projects and experiments.">
    <h1 class="mb-4 text-3xl font-bold">Projects</h1>
    <p class="mb-4">All documented projects appear below.</p>
    {projects.length === 0 && <p class="mb-4">No projects yet.</p>}
    {projects.map((project) => <ProjectCard project={project} />)}
</Layout>

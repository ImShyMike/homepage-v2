---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={`Blog | ${SITE_TITLE}`} description="All blog posts.">
    <div class="px-5 pt-4 pb-5">
        <h1 class="mb-4 text-3xl font-bold">Blog</h1>
        <p class="mb-4">Ramblings about random stuff</p>
        <div class="flex flex-col gap-4">
            {posts.length === 0 && <p class="mb-4">No posts yet.</p>}
            {posts.map((post) => <PostCard blog={post} />)}
        </div>
    </div>
</Layout>

---
import type { CollectionEntry } from 'astro:content';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';
import { getColorForString } from '../utils/colors';
import BaseCard from './BaseCard.astro';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
const { data, id } = project;
const { title, description, link, repo, heroImage, techStack = [] } = data;
const href = `/projects/${id}`;
---

<BaseCard id={id} href={href} heroImage={heroImage}>
    <h3 class="text-xl font-bold">
        <a href={href} class="text-inherit" transition:name={`title-${id}`}>{title}</a>
    </h3>
    <p class="leading-relaxed" transition:name={`description-${id}`}>{description}</p>
    {
        techStack.length > 0 && (
            <div class="flex flex-wrap gap-1.5 text-xs" transition:name={`stack-${id}`}>
                {techStack.map((tech) => (
                    <span class={`rounded border px-1.5 py-0.5 ${getColorForString(tech)}`}>
                        {tech}
                    </span>
                ))}
            </div>
        )
    }
    <div class="mt-auto flex gap-2">
        {
            link && (
                <a
                    href={link}
                    class="flex items-center gap-1 text-inherit"
                    target="_blank"
                    rel="noopener"
                    data-umami-event="project-live-click"
                    data-umami-event-url={link}
                >
                    <ExternalLink class="h-6 w-6" /> Live
                </a>
            )
        }
        {
            repo && (
                <a
                    href={repo}
                    class="flex items-center gap-1 text-inherit"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-umami-event="project-repo-click"
                    data-umami-event-url={repo}
                >
                    <Github class="h-6 w-6" /> Code
                </a>
            )
        }
    </div>
</BaseCard>

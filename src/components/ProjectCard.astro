---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';
import { getColorForString } from '../utils/colors';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
const { data, id } = project;
const { title, description, link, repo, heroImage, techStack = [] } = data;
const href = `/project/${id}`;
---

<article
    class="border-ctp-surface0 hover:border-ctp-lavender/50 flex h-40 w-full border transition-colors"
>
    <div class="flex h-full max-w-[60%] flex-col gap-2 px-4 py-2">
        <h3 class="text-xl font-bold">
            <a href={href} class="text-inherit">{title}</a>
        </h3>
        <p class="mb-auto leading-relaxed">{description}</p>
        {
            techStack.length > 0 && (
                <div class="flex flex-wrap gap-1.5 text-xs">
                    {techStack.map((tech) => (
                        <span class={`rounded border px-1.5 py-0.5 ${getColorForString(tech)}`}>
                            {tech}
                        </span>
                    ))}
                </div>
            )
        }
        <div class="mt-auto flex gap-2">
            {
                link && (
                    <a href={link} class="flex items-center gap-1 text-inherit">
                        <ExternalLink class="h-4 w-4" /> Live
                    </a>
                )
            }
            {
                repo && (
                    <a href={repo} class="flex items-center gap-1 text-inherit">
                        <Github class="h-4 w-4" /> Code
                    </a>
                )
            }
        </div>
    </div>
    {heroImage && <Image src={heroImage} alt="" class="ml-auto max-w-[40%]" loading="eager" />}
</article>

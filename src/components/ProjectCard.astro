---
import type { CollectionEntry } from 'astro:content';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';
import { getColorForString } from '../utils/colors';
import { Image } from 'astro:assets';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
const { data, id } = project;
const { title, description, link, repo, heroImage, techStack = [] } = data;
const href = `/projects/${id}`;
---

<article
    class="border-ctp-surface0 hover:border-ctp-lavender/50 flex w-full flex-col border transition-colors md:h-55 md:flex-row"
>
    <div class="order-2 flex h-full flex-col gap-2 px-5 py-3 md:order-1 md:max-w-[60%]">
        <h3 class="text-xl font-bold">
            <a href={href} class="text-inherit">{title}</a>
        </h3>
        <p class="leading-relaxed">{description}</p>
        {
            techStack.length > 0 && (
                <div class="flex flex-wrap gap-1.5 text-xs">
                    {techStack.map((tech) => (
                        <span class={`rounded border px-1.5 py-0.5 ${getColorForString(tech)}`}>
                            {tech}
                        </span>
                    ))}
                </div>
            )
        }
        <div class="mt-auto flex gap-2">
            {
                link && (
                    <a href={link} class="flex items-center gap-1 text-inherit" target="_blank">
                        <ExternalLink class="h-6 w-6" /> Live
                    </a>
                )
            }
            {
                repo && (
                    <a
                        href={repo}
                        class="flex items-center gap-1 text-inherit"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <Github class="h-6 w-6" /> Code
                    </a>
                )
            }
        </div>
    </div>
    {
        heroImage && (
            <Image
                src={heroImage}
                format="webp"
                alt="project image"
                widths={[150, 300, 600, heroImage.width]}
                sizes="(max-width: 768px) 600px, 400px"
                class="max-w-full object-cover md:max-w-[45%]"
                quality="mid"
                layout="constrained"
                loading="eager"
            />
        )
    }
</article>

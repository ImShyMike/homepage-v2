---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import Github from '~icons/lucide/github';
import ExternalLink from '~icons/lucide/external-link';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
const { data, id } = project;
const { title, description, date, link, repo, heroImage } = data;
const href = `/project/${id}`;
---

<article
    class="border-ctp-surface0 hover:border-ctp-lavender/50 flex w-full border transition-colors h-40"
>
    <div class="px-4 py-2 h-full flex flex-col gap-2 max-w-[60%]">
        <h3 class="text-xl font-bold">
            <a href={href} class="text-inherit">{title}</a>
        </h3>
        <p class="mb-auto leading-relaxed">{description}</p>
        <div class="flex gap-2">
            {link && (
                <a href={link} class="text-inherit flex items-center gap-1">
                    <ExternalLink class="h-4 w-4" /> Live
                </a>
            )}
            {repo && (
                <a href={repo} class="text-inherit flex items-center gap-1">
                    <Github class="h-4 w-4" /> Code
                </a>
            )}
        </div>
        <p class="text-ctp-subtext0 mt-auto"><FormattedDate date={date} /></p>
    </div>
    {heroImage && (
        <Image
            src={heroImage}
            alt=""
            class="ml-auto max-w-[40%]"
            loading="eager"
        />
    )}
</article>

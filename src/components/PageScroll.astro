<div class="fixed top-0 left-0 z-50 h-1 w-full overflow-hidden">
    <div class="animate-scroll bg-ctp-lavender h-1 w-0"></div>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const scrollBar = document.querySelector('.animate-scroll') as HTMLElement;

        if (!scrollBar) {
            return;
        }

        const updateScroll = () => {
            console.log('Updating scroll bar');
            const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            const scrollHeight =
                document.documentElement.scrollHeight - document.documentElement.clientHeight;
            let percent = (scrollTop / scrollHeight) * 100;
            scrollBar.style.width = percent + '%';
        };

        window.addEventListener('scroll', updateScroll, { passive: true });
        window.addEventListener('resize', updateScroll, { passive: true });
        updateScroll();

        const cleanup = () => {
            window.removeEventListener('scroll', updateScroll);
            window.removeEventListener('resize', updateScroll);
        };

        // self-destruct if navitating to another page
        document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
</script>

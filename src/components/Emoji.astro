---
import Image from 'astro/components/Image.astro';

interface Props {
    name: string;
    large?: boolean;
}

const { name, large } = Astro.props as Props;
---

<Image
    class:list={[
        'emoji bg-ctp-text/50 before:animate-pulse text-transparent transition-all',
        { large: large },
    ]}
    src={`https://cachet.dunkirk.sh/emojis/${name}/r`}
    title={name}
    alt={name}
    loading="eager"
    width={32}
    height={32}
/>

---
import Image from 'astro/components/Image.astro';

interface Props {
    name: string;
    large?: boolean;
}

const { name, large } = Astro.props as Props;
---

<Image
    class:list={['emoji', { large: large }]}
    src={`https://cachet.dunkirk.sh/emojis/${name}/r`}
    title={name}
    alt={name}
    priority
    quality="high"
    width={large ? 64 : 32}
    height={large ? 64 : 32}
/>

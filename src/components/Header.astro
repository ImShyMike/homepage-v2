---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="mt-8 bg-transparent">
    <nav
        class="bg-ctp-crust border-ctp-surface1 mx-auto flex max-w-240 items-center justify-between border border-b-0"
    >
        <div class="flex font-bold">
            <a
                href="/"
                class="border-ctp-surface1 h-full border-r px-6 py-3 text-inherit no-underline"
                >{SITE_TITLE}</a
            >
        </div>
        <div class="bg-ctp-surface0/15 flex-1 p-6"></div>
        <div class="flex">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/project">Projects</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
        </div>
    </nav>
</header>

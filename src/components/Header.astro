---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchMenu from './SearchMenu.svelte';
---

<header class="bg-transparent">
    <nav
        class="bg-ctp-crust border-ctp-surface1 mx-auto flex max-w-240 flex-wrap items-stretch justify-between border border-b-0 sm:flex-nowrap"
    >
        <div class="flex flex-1 grow-0 font-bold text-ctp-lavender items-center">
            <a
                href="/"
                class="border-ctp-surface1 h-full flex flex-1 grow items-center border-r px-6 text-inherit no-underline text text-xl"
                >{SITE_TITLE}</a
            >
        </div>
        <div class="bg-ctp-surface0/15 block flex-1 p-6"></div>
        <div
            class="border-ctp-surface1 order-last flex w-full gap-0 border-t px-0 py-0 sm:order-0 sm:w-auto sm:flex-row sm:items-center sm:border-t-0"
        >
            <HeaderLink class="w-full border-l-0 text-center sm:w-auto sm:border-l" href="/"
                >Home</HeaderLink
            >
            <HeaderLink class="w-full text-center sm:w-auto" href="/projects">Projects</HeaderLink>
            <HeaderLink class="w-full text-center sm:w-auto" href="/blog">Blog</HeaderLink>
        </div>
        <SearchMenu client:idle />
    </nav>
</header>

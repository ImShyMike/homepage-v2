---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getColorForString } from '../utils/colors';
import BaseCard from './BaseCard.astro';

interface Props {
    blog: CollectionEntry<'blog'>;
}

const { blog } = Astro.props as Props;
const { data, id } = blog;
const { title, description, pubDate, updatedDate, tags = [], heroImage } = data;
const href = `/blog/${id}`;
---

<BaseCard id={id} href={href} heroImage={heroImage}>
    <h3 class="text-xl font-bold">
        <a href={href} class="text-inherit" transition:name={`title-${id}`}>{title}</a>
    </h3>
    <p class="leading-relaxed" transition:name={`description-${id}`}>{description}</p>
    {
        tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 text-xs" transition:name={`tags-${id}`}>
                {tags.map((tag) => (
                    <span class={`rounded border px-1.5 py-0.5 ${getColorForString(tag)}`}>
                        #{tag}
                    </span>
                ))}
            </div>
        )
    }
    <p class="text-ctp-subtext0 mt-auto">
        <FormattedDate date={pubDate} />{
            updatedDate && (
                <span class="text-sm">
                    (updated <FormattedDate date={updatedDate} />)
                </span>
            )
        }
    </p>
</BaseCard>

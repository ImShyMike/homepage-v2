---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import { getColorForString } from '../utils/colors';

interface Props {
    blog: CollectionEntry<'blog'>;
}

const { blog } = Astro.props as Props;
const { data, id } = blog;
const { title, description, pubDate, updatedDate, tags = [], heroImage } = data;
const href = `/blog/${id}`;
---

<article
    class="border-ctp-surface0 hover:border-ctp-lavender/50 flex h-40 w-full border transition-colors"
>
    <div class="flex h-full max-w-[60%] flex-col gap-2 px-4 py-2">
        <h3 class="text-xl font-bold">
            <a href={href} class="text-inherit">{title}</a>
        </h3>
        <p class="mb-auto leading-relaxed">{description}</p>
        {
            tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 text-xs">
                    {tags.map((tag) => (
                        <span class={`rounded border px-1.5 py-0.5 ${getColorForString(tag)}`}>
                            #{tag}
                        </span>
                    ))}
                </div>
            )
        }
        <p class="text-ctp-subtext0 mt-auto">
            <FormattedDate date={pubDate} />{
                updatedDate && (
                    <span class="text-sm">
                        (updated <FormattedDate date={updatedDate} />)
                    </span>
                )
            }
        </p>
    </div>
    {heroImage && <Image src={heroImage} alt="" class="ml-auto max-w-[40%]" loading="eager" />}
</article>

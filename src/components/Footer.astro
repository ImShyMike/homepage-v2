---
import Github from '~icons/lucide/github';
import Rss from '~icons/lucide/rss';
import GitCommitVertical from '~icons/lucide/git-commit-vertical';
import { GITHUB } from '../consts';

const userUrl = `https://github.com/${GITHUB.name}`;
const COMMIT_SHA = import.meta.env.CF_PAGES_COMMIT_SHA;
const shortHash = COMMIT_SHA === undefined ? 'dev' : COMMIT_SHA.slice(0, 7);
const gitCommitUrl = COMMIT_SHA ? `${userUrl}/${GITHUB.repo}/commit/${COMMIT_SHA}` : '';
---

<footer class="mb-8 flex w-full justify-center">
    <div class="bg-ctp-crust border-ctp-surface1 w-240 border border-t-0 shadow-lg">
        <div class="flex w-full items-center p-2 sm:gap-2.5">
            <div class="flex-1">
                <a
                    href={gitCommitUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ctp-text flex items-center text-sm transition-colors sm:text-base"
                >
                    <GitCommitVertical class="h-4 w-4 sm:h-5 sm:w-5" /><span class="mr-0.5"
                        >{shortHash}</span
                    >
                </a>
            </div>

            <div class="flex flex-1 justify-center">
                <a href="/buttons" class="text-sm">buttons</a>
            </div>

            <div class="flex flex-1 justify-end gap-2 text-center">
                <a
                    href={userUrl}
                    aria-label="GitHub"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ctp-text flex items-center transition-colors"
                >
                    <Github class="h-4.5 w-4.5 sm:h-5.5 sm:w-5.5" />
                </a>

                <a
                    href="/rss.xml"
                    aria-label="RSS Feed"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ctp-text flex items-center transition-colors"
                >
                    <Rss class="h-4.5 w-4.5 sm:h-5.5 sm:w-5.5" />
                </a>
            </div>
        </div>
    </div>
</footer>
